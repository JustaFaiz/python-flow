def suggest_category(sheet_name):
    name = sheet_name.lower()
    best, best_score = UNCLASSIFIED, 0
    for cat, kws in CATEGORY_KEYWORDS.items():
        score = sum(1 for kw in kws if kw in name)
        if score > best_score:
            best, best_score = cat, score
    return best, best_score


def connectivity_lean(fed_by, fed_into):
    """Pure structural signal, no name-guessing: a sheet nothing feeds
    but that feeds others looks like a source (Input); a sheet that both
    receives and sends looks like a transformation step (Process); a
    sheet that only receives looks like an end deliverable (Output). An
    isolated sheet (neither) gives no structural signal at all."""
    if fed_by == 0 and fed_into > 0:
        return "Input"
    if fed_by > 0 and fed_into > 0:
        return "Process"
    if fed_by > 0 and fed_into == 0:
        return "Output"
    return None


def suggest_stage(sheet_name, fed_by, fed_into):
    """Combines both signals: a keyword hit is the stronger, more
    specific signal (it points at an actual named category) so it wins
    when present; connectivity is the fallback for sheets with no
    recognizable name but a clear structural role."""
    _cat, score = suggest_category(sheet_name)
    if score > 0:
        return CATEGORY_TO_STAGE.get(_cat, UNCLASSIFIED)
    lean = connectivity_lean(fed_by, fed_into)
    return lean if lean else UNCLASSIFIED


def suggest_category_within_stage(sheet_name, stage):
    """Best keyword-matched category, restricted to one stage's fixed
    list - used once a sheet has already been sorted into a stage, to
    pre-fill its sub-heading (category) dropdown."""
    if stage not in CATEGORY_TAXONOMY:
        return None
    name = sheet_name.lower()
    best, best_score = None, 0
    for cat in CATEGORY_TAXONOMY[stage]:
        score = sum(1 for kw in CATEGORY_KEYWORDS.get(cat, []) if kw in name)
        if score > best_score:
            best, best_score = cat, score
    return best


def sheet_connectivity_stats(per_file_flow, all_sheets):
    """(fed_by_count, fed_into_count) per (file, sheet), derived from the
    already-computed per-file flow (no re-parsing)."""
    stats = {}
    for fname, flow in per_file_flow.items():
        fed_by, fed_into = {}, {}
        for (src, dst), _cnt in flow.items():
            fed_into.setdefault(src, set()).add(dst)
            fed_by.setdefault(dst, set()).add(src)
        for _f, sheet in [s for s in all_sheets if s[0] == fname]:
            stats[(fname, sheet)] = (len(fed_by.get(sheet, ())), len(fed_into.get(sheet, ())))
    return stats


