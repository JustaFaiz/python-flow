# 2. FLOW RULES
# =================================================================

ALLOWED_STAGE_TRANSITIONS = {
    ("Input", "Input"),
    ("Input", "Process"),
    ("Process", "Process"),
    ("Process", "Output"),
}

STAGE_COLOR = {
    "Input": "#2ecc71",
    "Process": "#2a9d8f",
