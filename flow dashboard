class Handler(BaseHTTPRequestHandler):
    html_content = ""
    node_file_path = {}      # node id -> workbook path
    node_sheet_name = {}     # node id -> real sheet name (as it exists in that workbook)
    precedent_cells = {}     # node id -> [cell addresses]
    dependent_cells = {}     # node id -> [cell addresses]

    def log_message(self, format, *args):
        pass

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/lineage_flow.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(Handler.html_content.encode("utf-8"))
        elif parsed.path == "/open":
            qs = parse_qs(parsed.query)
            node = qs.get("id", [None])[0]
            want_pre = qs.get("precedents", ["true"])[0].lower() == "true"
            want_dep = qs.get("dependents", ["true"])[0].lower() == "true"
            status = "ok"
            try:
                path = Handler.node_file_path.get(node)
                sheet = Handler.node_sheet_name.get(node)
                if not path or not sheet:
                    raise RuntimeError("Unknown node")
                pre = sorted(Handler.precedent_cells.get(node, [])) if want_pre else []
                dep = sorted(Handler.dependent_cells.get(node, [])) if want_dep else []
                result = open_sheet_in_excel(path, sheet, precedent_cells=pre, dependent_cells=dep)
                notes = []
                if result.get("precedents_truncated"):
                    notes.append("precedents capped at 300")
                if result.get("dependents_truncated"):
                    notes.append("dependents capped at 300")
                if notes:
                    status = "ok (" + ", ".join(notes) + ")"
            except Exception as e:
                status = str(e)
                print(f"[!] Could not open node '{node}' in Excel: {e}")
                import traceback
                traceback.print_exc()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(status.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()


def main():
    if len(sys.argv) < 2:
        print("Usage: python lineage_flow_visual.py <handoff.json> [min_cells]")
        sys.exit(1)
    handoff_path = sys.argv[1]
    min_cells = DEFAULT_MIN_CELLS
    if len(sys.argv) >= 3:
        try:
            min_cells = int(sys.argv[2])
        except ValueError:
            pass

    with open(handoff_path, "r", encoding="utf-8") as f:
        handoff = json.load(f)
    files = handoff["files"]              # {filename: path}
    classification = handoff.get("classification", {})  # {"file::sheet": {"stage":..,"category":..}}
    multi_file = len(files) > 1

    combined_flow = {}
    node_info = {}  # node id -> {file, sheet, stage, category}
    precedent_cells, dependent_cells = {}, {}
    node_file_path, node_sheet_name = {}, {}

    for fname, fpath in files.items():
        formulas, sheet_names, sheet_bounds = load_formulas(fpath)
        flow, prec, dep = build_flow_and_arrows(formulas, sheet_bounds, min_cells)
        for sheet in sheet_names:
            nid = f"{fname}::{sheet}"
            cls = classification.get(nid, {})
            node_info[nid] = {
                "file": fname, "sheet": sheet,
                "stage": cls.get("stage", UNCLASSIFIED),
                "category": cls.get("category", UNCLASSIFIED),
            }
            node_file_path[nid] = fpath
            node_sheet_name[nid] = sheet
            if sheet in prec:
                precedent_cells[nid] = prec[sheet]
            if sheet in dep:
                dependent_cells[nid] = dep[sheet]
        for (src, dst), cnt in flow.items():
            combined_flow[(f"{fname}::{src}", f"{fname}::{dst}")] = cnt

    if not combined_flow:
        print("No cross-sheet formula links found across the given file(s) - nothing to draw.")
        return

    def label_of(nid):
        info = node_info[nid]
        return f"{info['sheet']}\n({info['file']})" if multi_file else info["sheet"]

    nodes_json = []
    for nid, info in node_info.items():
        stage = info["stage"]
        nodes_json.append({
            "id": nid, "label": label_of(nid), "shape": "box",
            "level": STAGE_LEVEL.get(stage, 3),
            "title": f"{label_of(nid)}\nStage: {stage}\nCategory: {info['category']}\nClick to switch to this sheet in Excel",
            "color": {"background": STAGE_COLOR.get(stage, STAGE_COLOR[UNCLASSIFIED]),
                      "border": "#ffffff" if stage != UNCLASSIFIED else "#666666"},
            "borderWidth": 3 if stage != UNCLASSIFIED else 1,
        })

    edges_json = []
    for (src, dst), cnt in combined_flow.items():
        s_stage, d_stage = node_info[src]["stage"], node_info[dst]["stage"]
        if s_stage == UNCLASSIFIED or d_stage == UNCLASSIFIED:
            edges_json.append({"from": src, "to": dst, "label": str(cnt), "color": "#8e6bbf",
                                "dashes": [2, 2], "title": f"{cnt} formula cell(s) - touches an unclassified sheet"})
        elif (s_stage, d_stage) in ALLOWED_STAGE_TRANSITIONS:
            edges_json.append({"from": src, "to": dst, "label": str(cnt), "color": "#888888",
                                "title": f"{cnt} formula cell(s) - {s_stage} -> {d_stage}"})
        else:
            edges_json.append({"from": src, "to": dst, "label": f"ANOMALY ({cnt})", "color": "#e63946",
                                "dashes": [6, 3], "width": 3,
                                "title": f"Rule violation: {s_stage} -> {d_stage} is not an allowed transition"})

    html = HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes_json)).replace("__EDGES__", json.dumps(edges_json))

    # Companion trace-data export, written next to the handoff file.
    try:
        out_dir = os.path.dirname(os.path.abspath(handoff_path))
        trace_path = os.path.join(out_dir, "lineage_trace_data.xlsx")
        export_trace_summary(node_info, combined_flow, trace_path)
        print(f"Wrote lineage trace data to {trace_path}")
    except Exception as e:
        print(f"[!] Could not write trace data workbook: {e}")

    Handler.html_content = html
    Handler.node_file_path = node_file_path
    Handler.node_sheet_name = node_sheet_name
    Handler.precedent_cells = precedent_cells
    Handler.dependent_cells = dependent_cells

    server = HTTPServer(("127.0.0.1", PORT), Handler)
    actual_port = server.server_address[1]
    url = f"http://127.0.0.1:{actual_port}/"
    print(f"\nServing lineage flow visual at {url}")
    print("Leave this window open while you use it - Ctrl+C here to stop.")
    threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
