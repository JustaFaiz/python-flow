# Excel COM automation - identical approach to the original
# sheet_tree_server.py, adapted to take an explicit workbook path per
# call since a lineage graph here can span multiple workbooks.
# ---------------------------------------------------------------

_last_auto_unhidden = {"path": None, "sheet": None}


def open_sheet_in_excel(workbook_path, sheet_name, precedent_cells=None, dependent_cells=None):
    import win32com.client as win32
    import pywintypes
    import win32gui
    import win32process
    import win32api
    import win32con

    def com_retry(func, attempts=6, delay=0.4, required=True):
        last_exc = None
        for _ in range(attempts):
            try:
                return func()
            except Exception as e:
                last_exc = e
                time.sleep(delay)
        if required:
            raise last_exc
        return None

    def norm(p):
        return os.path.normcase(os.path.normpath(p))

    abs_path = os.path.abspath(workbook_path)
    target_norm = norm(abs_path)
    target_base = os.path.basename(abs_path).lower()

    excel, wb = None, None
    try:
        excel = win32.GetActiveObject("Excel.Application")
    except pywintypes.com_error:
        excel = None

    if excel is not None:
        for book in excel.Workbooks:
            try:
                if norm(book.FullName) == target_norm:
                    wb = book
                    break
            except Exception:
                continue
        if wb is None:
            for book in excel.Workbooks:
                try:
                    if book.Name.lower() == target_base:
                        wb = book
                        break
                except Exception:
                    continue

    if excel is None:
        excel = win32.Dispatch("Excel.Application")

    com_retry(lambda: setattr(excel, "Visible", True))
    com_retry(lambda: setattr(excel, "DisplayAlerts", False), required=False)
    com_retry(lambda: setattr(excel, "AskToUpdateLinks", False), required=False)

    if wb is None:
        wb = com_retry(lambda: excel.Workbooks.Open(abs_path, 0))

    def exit_protected_view():
        if wb.ProtectedViewWindow is not None:
            return wb.ProtectedViewWindow.Edit()
        return wb
    new_wb = com_retry(exit_protected_view, required=False)
    if new_wb is not None:
        wb = new_wb

    com_retry(lambda: setattr(excel, "DisplayAlerts", False), required=False)
    com_retry(lambda: wb.Activate())

    global _last_auto_unhidden
    if (_last_auto_unhidden["path"] == target_norm
            and _last_auto_unhidden["sheet"] is not None
            and _last_auto_unhidden["sheet"] != sheet_name):
        com_retry(lambda: setattr(wb.Sheets(_last_auto_unhidden["sheet"]), "Visible", 0), required=False)
        _last_auto_unhidden["sheet"] = None

    sht = com_retry(lambda: wb.Sheets(sheet_name))
    was_hidden = com_retry(lambda: sht.Visible != -1, required=False)
    if was_hidden:
        com_retry(lambda: setattr(sht, "Visible", -1), required=False)
    com_retry(lambda: sht.Activate())
    if was_hidden:
        _last_auto_unhidden["path"] = target_norm
        _last_auto_unhidden["sheet"] = sheet_name

    MAX_ARROWS_PER_TYPE = 300

    def draw_arrows(addresses, method_name):
        addresses = list(addresses)
        truncated = len(addresses) > MAX_ARROWS_PER_TYPE
        if truncated:
            addresses = addresses[:MAX_ARROWS_PER_TYPE]
        for addr in addresses:
            com_retry(lambda addr=addr: getattr(sht.Range(addr), method_name)(), required=False)
        return truncated

    com_retry(lambda: setattr(excel, "ScreenUpdating", False), required=False)
    try:
        com_retry(lambda: sht.ClearArrows(), required=False)
        precedents_truncated = draw_arrows(precedent_cells, "ShowPrecedents") if precedent_cells else False
        dependents_truncated = draw_arrows(dependent_cells, "ShowDependents") if dependent_cells else False
    finally:
        com_retry(lambda: setattr(excel, "ScreenUpdating", True), required=False)

    try:
        hwnd = wb.Windows(1).Hwnd
        win32api.keybd_event(win32con.VK_MENU, 0, 0, 0)
        win32api.keybd_event(win32con.VK_MENU, 0, win32con.KEYEVENTF_KEYUP, 0)
        fg_hwnd = win32gui.GetForegroundWindow()
        fg_thread = win32process.GetWindowThreadProcessId(fg_hwnd)[0]
        target_thread = win32process.GetWindowThreadProcessId(hwnd)[0]
        current_thread = win32api.GetCurrentThreadId()
        win32process.AttachThreadInput(fg_thread, current_thread, True)
        win32process.AttachThreadInput(target_thread, current_thread, True)
        try:
            win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
            win32gui.BringWindowToTop(hwnd)
            win32gui.SetForegroundWindow(hwnd)
        finally:
            win32process.AttachThreadInput(fg_thread, current_thread, False)
            win32process.AttachThreadInput(target_thread, current_thread, False)
    except Exception:
        pass

    return {"precedents_truncated": precedents_truncated, "dependents_truncated": dependents_truncated}


