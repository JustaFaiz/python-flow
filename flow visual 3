      ctx.fillStyle = "rgba(210,210,210,0.85)";
      ctx.font = "13px sans-serif";
      ctx.textBaseline = "middle";
      ctx.fillText(lane.name, 8, lane.y0 + 16);
    });
    ctx.restore();
  });

  function loadView(view) {
    currentView = view;
    undoStack = [];
    nodes.clear(); edges.clear();
    network.setOptions(view === "clean" ? CLEAN_OPTIONS : FULL_OPTIONS);
    var nData = view === "clean" ? CLEAN_NODES : FULL_NODES;
    var eData = view === "clean" ? CLEAN_EDGES : FULL_EDGES;
    nodes.add(nData);
    edges.add(eData);
    if (view === "clean") {
      network.once("stabilizationIterationsDone", function () { network.setOptions({ physics: false }); });
    } else {
      network.fit();
