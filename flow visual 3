    document.getElementById('btnClean').classList.toggle('active', view === "clean");
    document.getElementById('btnFull').classList.toggle('active', view === "full");
    document.getElementById('legendClean').classList.toggle('active', view === "clean");
    document.getElementById('legendFull').classList.toggle('active', view === "full");
    buildPanel();
    buildSearchList();
    document.getElementById('status').innerText = "";
  }

  document.getElementById('btnClean').addEventListener('click', function () { loadView('clean'); });
  document.getElementById('btnFull').addEventListener('click', function () { loadView('full'); });

  network.on("click", function (params) {
    if (params.nodes.length > 0) {
      var id = params.nodes[0];
      var statusEl = document.getElementById('status');
      var showPre = document.getElementById('showPrecedents').checked;
      var showDep = document.getElementById('showDependents').checked;
      statusEl.innerText = "Opening: " + id + " ...";
      fetch('/open?id=' + encodeURIComponent(id) + '&precedents=' + showPre + '&dependents=' + showDep)
        .then(function(r) { return r.text(); })
        .then(function(text) {
          statusEl.innerText = text.indexOf("ok") === 0
            ? "Opened: " + id + (text.length > 2 ? " - " + text.slice(4, -1) : "")
            : text;
        })
        .catch(function(err) { statusEl.innerText = "Could not reach local server: " + err; });
    }
  });

  network.on("oncontext", function (params) {
    params.event.preventDefault();
    var nodeId = network.getNodeAt(params.pointer.DOM);
    if (nodeId) {
      var node = nodes.get(nodeId);
      applyChanges([{ id: nodeId, hidden: !node.hidden }]);
    }
  });

  function setHidden(id, hidden) {
    nodes.update({ id: id, hidden: hidden });
    var cb = document.querySelector('input[data-sheet-id="' + id + '"]');
    if (cb) cb.checked = !hidden;
  }
  function applyChanges(changes) {
    var undoEntry = [];
    changes.forEach(function(change) {
      var node = nodes.get(change.id);
      if (!node) return;
      undoEntry.push({ id: change.id, prevHidden: !!node.hidden });
      setHidden(change.id, change.hidden);
    });
    undoStack.push(undoEntry);
  }

  function buildPanel() {
    var checkboxContainer = document.getElementById('sheetCheckboxes');
    checkboxContainer.innerHTML = '';
    var ids = nodes.getIds().slice().sort();
    ids.forEach(function(id) {
      var node = nodes.get(id);
      var label = document.createElement('label');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.checked = true; cb.dataset.sheetId = id;
      cb.addEventListener('change', function() { applyChanges([{ id: id, hidden: !cb.checked }]); });
      label.appendChild(cb);
      label.appendChild(document.createTextNode(' ' + node.label.replace(/\\n/g, ' ')));
      checkboxContainer.appendChild(label);
    });
  }

  document.getElementById('showAllBtn').addEventListener('click', function() {
    applyChanges(nodes.getIds().map(function(id) { return { id: id, hidden: false }; }));
  });
  document.getElementById('hideAllBtn').addEventListener('click', function() {
    applyChanges(nodes.getIds().map(function(id) { return { id: id, hidden: true }; }));
  });
  document.getElementById('undoBtn').addEventListener('click', function() {
    var entry = undoStack.pop();
    if (!entry) return;
    entry.forEach(function(change) { setHidden(change.id, change.prevHidden); });
  });
  document.getElementById('togglePanelBtn').addEventListener('click', function() {
    var checkboxContainer = document.getElementById('sheetCheckboxes');
    var listVisible = checkboxContainer.style.display !== 'none';
    checkboxContainer.style.display = listVisible ? 'none' : 'block';
    ['showAllBtn','hideAllBtn','undoBtn'].forEach(function(bid) {
      document.getElementById(bid).style.display = listVisible ? 'none' : 'inline';
    });
    this.innerText = listVisible ? '[show list]' : '[hide list]';
  });

  function buildSearchList() {
    var sheetListEl = document.getElementById('sheetList');
    sheetListEl.innerHTML = '';
    nodes.getIds().slice().sort().forEach(function(id) {
      var opt = document.createElement('option');
      opt.value = nodes.get(id).label.replace(/\\n/g, ' ');
      sheetListEl.appendChild(opt);
    });
  }

  var highlightState = null;
  function clearHighlight() {
    if (highlightState) {
      nodes.update({ id: highlightState.id, color: highlightState.originalColor, borderWidth: highlightState.originalBorderWidth });
      highlightState = null;
    }
  }
  function highlightSheet(rawName) {
    clearHighlight();
    var name = (rawName || '').trim();
    if (!name) return false;
    var lower = name.toLowerCase();
    var ids = nodes.getIds();
    var match = ids.find(function(id) { return nodes.get(id).label.replace(/\\n/g,' ').toLowerCase() === lower; });
    if (!match) {
      match = ids.find(function(id) { return nodes.get(id).label.replace(/\\n/g,' ').toLowerCase().indexOf(lower) !== -1; });
    }
    if (!match) return false;
    setHidden(match, false);
    var node = nodes.get(match);
    var baseColor = (typeof node.color === 'string') ? node.color : (node.color && node.color.background) || '#2a9d8f';
    highlightState = { id: match, originalColor: node.color, originalBorderWidth: node.borderWidth || 1 };
    nodes.update({ id: match, borderWidth: 6, color: { background: baseColor, border: '#ff0055', highlight: { background: baseColor, border: '#ff0055' } } });
    network.selectNodes([match]);
    network.focus(match, { scale: 1.3, animation: { duration: 500, easingFunction: 'easeInOutQuad' } });
    return match;
  }
  function runSearch() {
    var val = document.getElementById('searchBox').value;
    var statusEl = document.getElementById('status');
    var found = highlightSheet(val);
    statusEl.innerText = found ? ('Found: ' + val) : ('No sheet matching "' + val + '" in this view');
  }
  document.getElementById('searchGoBtn').addEventListener('click', runSearch);
  document.getElementById('searchBox').addEventListener('keydown', function(e) { if (e.key === 'Enter') runSearch(); });
  document.getElementById('searchBox').addEventListener('input', function(e) { if (e.target.value.trim() === '') clearHighlight(); });

  window.addEventListener('resize', function() { network.redraw(); });

  loadView('clean');
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    html_content = ""
    node_file_path = {}      # node id -> workbook path
    node_sheet_name = {}     # node id -> real sheet name (as it exists in that workbook)
    precedent_cells = {}     # node id -> [cell addresses]
    dependent_cells = {}     # node id -> [cell addresses]
    external_ids = set()     # node ids that are declared external systems, not real sheets

    def log_message(self, format, *args):
        pass

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/lineage_flow.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(Handler.html_content.encode("utf-8"))
        elif parsed.path == "/open":
            qs = parse_qs(parsed.query)
            node = qs.get("id", [None])[0]
            want_pre = qs.get("precedents", ["true"])[0].lower() == "true"
            want_dep = qs.get("dependents", ["true"])[0].lower() == "true"
            if node in Handler.external_ids:
                status = "This is a declared external system - there's no Excel file to open."
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.end_headers()
                self.wfile.write(status.encode("utf-8"))
                return
            status = "ok"
            try:
                path = Handler.node_file_path.get(node)
                sheet = Handler.node_sheet_name.get(node)
                if not path or not sheet:
                    raise RuntimeError("Unknown node")
                pre = sorted(Handler.precedent_cells.get(node, [])) if want_pre else []
                dep = sorted(Handler.dependent_cells.get(node, [])) if want_dep else []
                result = open_sheet_in_excel(path, sheet, precedent_cells=pre, dependent_cells=dep)
                notes = []
                if result.get("precedents_truncated"):
                    notes.append("precedents capped at 300")
                if result.get("dependents_truncated"):
                    notes.append("dependents capped at 300")
                if notes:
                    status = "ok (" + ", ".join(notes) + ")"
            except Exception as e:
                status = str(e)
                print(f"[!] Could not open node '{node}' in Excel: {e}")
                import traceback
                traceback.print_exc()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(status.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()


def main():
    if len(sys.argv) < 2:
        print("Usage: python flow_visual.py <handoff.json> [min_cells]")
        sys.exit(1)
    handoff_path = sys.argv[1]
    min_cells = DEFAULT_MIN_CELLS
    if len(sys.argv) >= 3:
        try:
            min_cells = int(sys.argv[2])
        except ValueError:
            pass

    with open(handoff_path, "r", encoding="utf-8") as f:
        handoff = json.load(f)
    files = handoff["files"]              # {filename: path}
    file_data = handoff.get("file_data", {})  # {filename: {sheet_names, flow, precedent_cells, dependent_cells}} - precomputed by the dashboard's Scan step
    classification = handoff.get("classification", {})  # {"file::sheet": {"stage":..,"category":..}}
    multi_file = len(files) > 1

    combined_flow = {}
    node_info = {}  # node id -> {file, sheet, stage, category}
    precedent_cells, dependent_cells = {}, {}
    node_file_path, node_sheet_name = {}, {}

    t0 = time.time()
    for fname, fpath in files.items():
        if fname in file_data:
            # Already computed by the dashboard during Scan - no re-
            # opening or re-parsing the workbook here at all.
            fd = file_data[fname]
            sheet_names = fd["sheet_names"]
            flow = {(src, dst): cnt for src, dst, cnt in fd["flow"]}
            prec = {s: set(cells) for s, cells in fd["precedent_cells"].items()}
            dep = {s: set(cells) for s, cells in fd["dependent_cells"].items()}
        else:
            # Fallback (e.g. handoff built by an older dashboard version,
            # or the script run manually without one): parse it here.
            print(f"No precomputed data for '{fname}' - parsing it now...")
            formulas, sheet_names, sheet_bounds = load_formulas(fpath)
            flow, prec, dep = build_flow_and_arrows(formulas, sheet_bounds, min_cells)

        for sheet in sheet_names:
            nid = f"{fname}::{sheet}"
            cls = classification.get(nid, {})
            node_info[nid] = {
                "file": fname, "sheet": sheet,
                "stage": cls.get("stage", UNCLASSIFIED),
                "category": cls.get("category", UNCLASSIFIED),
                "external": False,
            }
            node_file_path[nid] = fpath
            node_sheet_name[nid] = sheet
            if sheet in prec:
                precedent_cells[nid] = prec[sheet]
            if sheet in dep:
                dependent_cells[nid] = dep[sheet]
        for (src, dst), cnt in flow.items():
            combined_flow[(f"{fname}::{src}", f"{fname}::{dst}")] = cnt
        print(f"  {fname}: {len(sheet_names)} sheet(s)")

    print(f"Loaded {len(files)} file(s), {len(node_info)} sheet(s), {len(combined_flow)} link(s) in {time.time()-t0:.2f}s")

    # External systems backbone - declared once in the dashboard, handed
    # off here as plain data. Each external node is its own swim lane;
    # backbone_edges are already resolved to concrete ids (either an
    # external name or a "file::sheet" id) by the dashboard.
    external_nodes = handoff.get("external_nodes", {})   # {name: stage}
    lane_order = handoff.get("lane_order", ["Excel"])
    backbone_edges_raw = handoff.get("backbone_edges", [])  # [[src, dst], ...]

    for name, stage in external_nodes.items():
        node_info[name] = {"file": None, "sheet": name, "stage": stage, "category": None, "external": True}

    backbone_edges = [(s, d) for s, d in backbone_edges_raw if s in node_info and d in node_info]

    if not combined_flow and not backbone_edges:
        print("No cross-sheet formula links or backbone links found - nothing to draw.")
        return

    def label_of(nid):
        info = node_info[nid]
        return info["sheet"] if (info.get("external") or not multi_file) else f"{info['sheet']}\n({info['file']})"

    def build_node(nid, x=None, y=None):
        info = node_info[nid]
        stage = info["stage"]
        node = {
            "id": nid, "label": label_of(nid), "shape": "box",
            "level": STAGE_LEVEL.get(stage, 3),
            "title": (f"{label_of(nid)}\nStage: {stage}" +
                      (f"\nCategory: {info['category']}" if info.get("category") else "") +
                      ("\n(external system - declared)" if info.get("external") else "\nClick to switch to this sheet in Excel")),
            "color": {"background": STAGE_COLOR.get(stage, STAGE_COLOR[UNCLASSIFIED]), "border": "#ffffff"},
            "borderWidth": 3,
        }
        if info.get("external"):
            node["shapeProperties"] = {"borderDashes": [4, 3]}
        if x is not None:
            node["x"], node["y"] = x, y
        return node

    # Sort every real flow link into exactly one of three buckets.
    normal_edges, anomaly_edges, unclassified_edges = [], [], []
    for (src, dst), cnt in combined_flow.items():
        s_stage, d_stage = node_info[src]["stage"], node_info[dst]["stage"]
        if s_stage == UNCLASSIFIED or d_stage == UNCLASSIFIED:
            unclassified_edges.append((src, dst, cnt))
        elif (s_stage, d_stage) in ALLOWED_STAGE_TRANSITIONS:
            normal_edges.append((src, dst, cnt, s_stage, d_stage))
        else:
            anomaly_edges.append((src, dst, cnt, s_stage, d_stage))

    # --- Clean Flow: classified sheets only, only the sheets that are
    # actually connected to another classified sheet, only normal
    # (rule-following) links - no unclassified touches, no anomalies, no
    # external systems, no dashed lines at all. Unchanged from before:
    # automatic hierarchical layout, not the swim-lane positioning. ---
    clean_ids = set()
    for src, dst, cnt, ss, ds in normal_edges:
        clean_ids.add(src)
        clean_ids.add(dst)
    clean_nodes_json = [build_node(nid) for nid in clean_ids]
    clean_edges_json = [
        {"from": src, "to": dst, "label": str(cnt), "color": "#888888",
         "title": f"{cnt} formula cell(s) - {ss} -> {ds}"}
        for src, dst, cnt, ss, ds in normal_edges
    ]

    # --- Full Flow: every sheet AND every declared external system, laid
    # out as swim lanes (one lane per system, "Excel" holding every real/
    # unclassified sheet sub-ordered by its own stage), every link type
    # called out distinctly. ---
    positions, lanes_meta, diagram_width = build_lane_layout(node_info, lane_order)
    full_nodes_json = [build_node(nid, *positions.get(nid, (0, 0))) for nid in node_info]
    full_edges_json = []
    for src, dst, cnt, ss, ds in normal_edges:
        full_edges_json.append({"from": src, "to": dst, "label": str(cnt), "color": "#888888",
                                 "title": f"{cnt} formula cell(s) - {ss} -> {ds}"})
    for src, dst, cnt in unclassified_edges:
        full_edges_json.append({"from": src, "to": dst, "label": str(cnt), "color": "#8e6bbf",
                                 "dashes": [2, 2], "title": f"{cnt} formula cell(s) - touches an unclassified sheet"})
    for src, dst, cnt, ss, ds in anomaly_edges:
        full_edges_json.append({"from": src, "to": dst, "label": f"ANOMALY ({cnt})", "color": "#e63946",
                                 "dashes": [6, 3], "width": 3,
                                 "title": f"Rule violation: {ss} -> {ds} is not an allowed transition"})
    for src, dst in backbone_edges:
        full_edges_json.append({"from": src, "to": dst, "color": "#6c6c6c", "dashes": [3, 3],
                                 "title": "Declared backbone link (not derived from a formula)"})

    html = (HTML_TEMPLATE
            .replace("__CLEAN_NODES__", json.dumps(clean_nodes_json))
            .replace("__CLEAN_EDGES__", json.dumps(clean_edges_json))
            .replace("__FULL_NODES__", json.dumps(full_nodes_json))
            .replace("__FULL_EDGES__", json.dumps(full_edges_json))
            .replace("__LANES_META__", json.dumps(lanes_meta))
            .replace("__DIAGRAM_WIDTH__", json.dumps(diagram_width)))

    # Companion trace-data export, written next to the handoff file.
    try:
        out_dir = os.path.dirname(os.path.abspath(handoff_path))
        trace_path = os.path.join(out_dir, "lineage_trace_data.xlsx")
        export_trace_summary(node_info, combined_flow, trace_path)
        print(f"Wrote lineage trace data to {trace_path}")
    except Exception as e:
        print(f"[!] Could not write trace data workbook: {e}")

    Handler.html_content = html
    Handler.node_file_path = node_file_path
    Handler.node_sheet_name = node_sheet_name
    Handler.precedent_cells = precedent_cells
    Handler.dependent_cells = dependent_cells
    Handler.external_ids = set(external_nodes.keys())

    server = HTTPServer(("127.0.0.1", PORT), Handler)
    actual_port = server.server_address[1]
    url = f"http://127.0.0.1:{actual_port}/"
    print(f"\nServing lineage flow visual at {url}")
    print("Leave this window open while you use it - Ctrl+C here to stop.")
    threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
